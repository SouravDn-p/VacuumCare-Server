# ==========================================
# Application
# ==========================================

PORT=5000
APP_PORT=5001


# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=myapp
POSTGRES_PORT=5433


# ==========================================
# Local Development Database URL
# ==========================================
# Used when NestJS runs directly on your machine.
#
# Local NestJS -> localhost:5433 -> PostgreSQL Docker container
# Docker Compose app container -> postgres:5432 (overridden by docker-compose.yaml)

DATABASE_URL=postgresql://postgres:password123@localhost:5433/myapp?schema=public


# ==========================================
# JWT
# ==========================================

JWT_SECRET=replace-with-at-least-32-random-characters


# ==========================================
# Agora
# ==========================================

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SECONDS=3600


# ==========================================
# Admin
# ==========================================

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password


# ==========================================
# Stripe
# ==========================================

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cad
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300


# ==========================================
# Tax
# ==========================================

TAX_RATE=0.14975


# ==========================================
# Client / CORS
# ==========================================

CLIENT_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000


# ==========================================
# Email (Brevo)
# ==========================================
# Used to send 5-digit OTP codes for signup email verification and password reset.
# Sign up at https://www.brevo.com and create a transactional email API key.

# Brevo transactional email API key
BREVO_API_KEY=

# From-address for all outbound emails (must be a verified sender in Brevo)
MAIL_FROM=noreply@example.com

# Display name shown in the email client
MAIL_FROM_NAME=Central Care


# ==========================================
# Cloudinary
# ==========================================
# Used for avatar and product image uploads.
# Sign up at https://cloudinary.com and copy credentials from your dashboard.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: unsigned upload preset name (leave blank to use signed uploads)
CLOUDINARY_UPLOAD_PRESET=
